# Copy to .env and fill in.

# Alpaca paper trading (https://app.alpaca.markets -> generate PAPER keys).
# Required for broker.mode: alpaca_paper and for Alpaca market data.
# Without them the bot falls back to the simulated broker + Yahoo Finance data.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Telegram reports (optional). Without these the bot still runs;
# reports print to the console instead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
